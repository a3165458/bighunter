# Telegram
TELEGRAM_BOT_TOKEN=你的Bot Token
TELEGRAM_CHAT_ID=你的Chat ID
# Forum 群组的话题 ID（普通群组留 0）
TELEGRAM_TOPIC_ID=0

# 过滤阈值（USD）
MIN_USD_VALUE=50000

# Webhook 鉴权（可选，留空则不校验）
WEBHOOK_SECRET=

# ---- 币安上币过滤 ----
# 仅播报已在币安（现货或合约）上架的代币
REQUIRE_BINANCE_LISTING=true
# 币安上币列表缓存刷新间隔（秒），默认 3600 = 1小时
BINANCE_REFRESH_INTERVAL=3600

# 日志级别
LOG_LEVEL=INFO

# ---- Arkham 页面轮询（可选） ----
ARKHAM_POLLING_ENABLED=false
ARKHAM_TRANSFERS_URL=
ARKHAM_POLL_INTERVAL_SECONDS=30
ARKHAM_HEADLESS=true
# CDP 模式：挂接已在运行的 Chrome（见 README"CDP 模式"一节），留空则自建浏览器
ARKHAM_CDP_URL=
# 全页文本正则兜底提取（可能误报，生产建议 false）
ARKHAM_TEXT_FALLBACK=false
