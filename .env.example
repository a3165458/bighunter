# Telegram（必填，用于播报）
TELEGRAM_BOT_TOKEN=你的Bot Token
TELEGRAM_CHAT_ID=你的Chat ID
# Forum 群组的话题 ID（普通群组留 0）
TELEGRAM_TOPIC_ID=0

# 大额阈值（USD）：只播报 ≥ 该金额的转账
MIN_USD_VALUE=1000000

# Webhook 鉴权（可选，留空则不校验）
WEBHOOK_SECRET=

# ---- 过滤策略 ----
# 仅播报已在币安上架的代币（冷门币监控可设 true；全量大额可 false）
REQUIRE_BINANCE_LISTING=false
BINANCE_REFRESH_INTERVAL=3600
# true=排除 BTC/ETH/稳定币等主流；要监控全部大额时设 false
FILTER_MAINSTREAM_TOKENS=false

# ---- 代币屏蔽 / 妖币热度（解决同一代币反复刷屏） ----
# 静态黑名单，逗号分隔；Telegram 按钮 /mute 会额外写入 TOKEN_GUARD_PATH
BLOCKED_TOKENS=
TOKEN_GUARD_PATH=/data/token_guard.json
# 同一代币两次播报最短间隔（秒）；0=关闭。默认 1 小时
TOKEN_COOLDOWN_SECONDS=3600
# 金额达到该值可突破冷却和热度上限；0=不允许突破
TOKEN_COOLDOWN_BREAK_USD=0
# 妖币模式：窗口内同一代币超过次数视为噪音。关了仍可用屏蔽和冷却
YAOBI_MODE=true
TOKEN_MAX_ALERTS_PER_WINDOW=2
TOKEN_ALERT_WINDOW_SECONDS=21600
# 告警底部显示「屏蔽此币 / 静音 6h」按钮
TELEGRAM_MUTE_BUTTON=true
# 允许点按钮/发命令的 Telegram user id，逗号分隔；留空=该群任何人可操作
TELEGRAM_ADMIN_USER_IDS=

LOG_LEVEL=INFO

# =====================================================================
# 唯一数据源：Arkham（arkm.com）。二选一，不要同时满足两个条件：
#   1) 无 API Key → 公开页浏览器路径（匿名，无需登录，推荐）
#   2) 有 API Key → REST 路径（最稳）
# =====================================================================

# ---- 模式 1（推荐，无 API Key / 无账户登录）：公开页轮询 + CDP 过 Cloudflare ----
# ARKHAM_POLLING_ENABLED=true 时，Bot 通过 Playwright/CDP 驱动真实 Chrome
# 打开 arkm.com 首页，抓取 RECENT TRANSFERS / 公开 transfers 接口，全程免登录。
ARKHAM_POLLING_ENABLED=true
ARKHAM_TRANSFERS_URL=https://arkm.com/transfers
ARKHAM_POLL_INTERVAL_SECONDS=30
# CDP 模式：挂接一个已打开 arkm.com 且已通过 Cloudflare 的 Chrome（推荐，零验证摩擦）。
#   - Docker（network_mode: host）：http://127.0.0.1:9222（宿主 Chrome）
#   - 本机直接跑脚本：http://127.0.0.1:9222 或带端口的远程地址
# 留空则自建浏览器并尝试 DOM 自动勾选 Turnstile 验证框
ARKHAM_CDP_URL=http://127.0.0.1:9222
# 未挂接 CDP 时自建浏览器的模式：true=无头（自动勾选验证框），false=有头（可 VNC 人工过 CF）
ARKHAM_HEADLESS=true
# true=不要求 Arkham 账户登录（仍会读写 cookie 罐应对 Cloudflare）
ARKHAM_ANONYMOUS_MODE=true
# storage state 保存路径（CF clearance cookie；Docker 内为 /data 映射宿主 ./data）
ARKHAM_STORAGE_STATE_PATH=/data/arkham-storage-state.json
# Cloudflare 挑战最长等待秒数（期间会自动尝试勾选验证框）
ARKHAM_CF_WAIT_SECONDS=120
# CDP 模式下每轮是否 reload（false=只读当前 DOM，更不易触发 CF）
ARKHAM_CDP_RELOAD=false
# 全页文本正则兜底提取（可能误报，生产建议 false）
ARKHAM_TEXT_FALLBACK=false
# 住宅/移动代理（机房 IP 直连 arkm 常被 CF 硬拦）
# VLESS 需先由 xray/sing-box 暴露本地 SOCKS/HTTP 端口，再填写桥接地址。
# 例: http://user:pass@gate.smartproxy.com:7000 或 socks5://127.0.0.1:10808
ARKHAM_PROXY_SERVER=

# ---- 模式 2（可选，有 Key 才填）：Arkham 官方 REST ----
# 申请地址 https://arkm.com/api。填了 Key 后公开页轮询自动跳过（避免双源重复推送）。
ARKHAM_API_KEY=
ARKHAM_API_BASE_URL=https://api.arkm.com
# 逗号分隔实体，留空=默认 binance,coinbase,okx,bybit,kraken,bitfinex；全量可填 all
ARKHAM_API_BASES=
ARKHAM_API_USD_GTE=0
ARKHAM_API_LIMIT=50
ARKHAM_API_POLL_INTERVAL_SECONDS=60