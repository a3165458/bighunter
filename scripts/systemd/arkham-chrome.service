[Unit]
Description=Google Chrome for Arkham CDP (chromeuser, socks5 via xray)
After=xray.service network-online.target
Wants=xray.service

[Service]
Type=simple
User=chromeuser
Environment=DISPLAY=:99
ExecStart=/usr/bin/google-chrome --remote-debugging-port=9222 --user-data-dir=/home/chromeuser/chrome-data --no-first-run --no-default-browser-check --disable-extensions --disable-blink-features=AutomationControlled --window-size=1440,900 --proxy-server=socks5://127.0.0.1:10808 https://arkm.com/transfers
Restart=always
RestartSec=15
# 预防性回收：CDP 挂接几天后会假活（HTTP 通、协议挂）。6 小时换一轮。
RuntimeMaxSec=6h
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
